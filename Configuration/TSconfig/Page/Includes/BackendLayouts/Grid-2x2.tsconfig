mod {
  web_layout {
    BackendLayouts {
      grid-2x2 {
        config {
          backend_layout {
            colCount = 2
            rowCount = 2

            rows {
              1 {
                columns {
                  1 {
                    colPos = 0
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/grid-2x2.xlf:content1.1
                  }

                  2 {
                    colPos = 1
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/grid-2x2.xlf:content1.2
                  }
                }
              }

              2 {
                columns {
                  1 {
                    colPos = 2
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/grid-2x2.xlf:content2.1
                  }

                  2 {
                    colPos = 3
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/grid-2x2.xlf:content2.2
                  }
                }
              }
            }
          }
        }

        icon = EXT:templates/Resources/Public/Icons/BackendLayouts/Grid-2x2.svg
        title = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/grid-2x2.xlf:title
      }
    }
  }
}
