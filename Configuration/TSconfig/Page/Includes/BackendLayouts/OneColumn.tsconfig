mod {
  web_layout {
    BackendLayouts {
      oneColumn {
        config {
          backend_layout {
            colCount = 1
            rowCount = 2

            rows {
              1 {
                columns {
                  1 {
                    colPos = 100
                    name = LLL:EXT:frontend_templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/oneColumn.xlf:stage
                  }
                }
              }

              2 {
                columns {
                  1 {
                    colPos = 0
                    name = LLL:EXT:frontend_templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/oneColumn.xlf:content1
                  }
                }
              }
            }
          }
        }

        icon = EXT:frontend_templates/Resources/Public/Icons/BackendLayouts/OneColumn.svg
        title = LLL:EXT:frontend_templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/oneColumn.xlf:title
      }
    }
  }
}
