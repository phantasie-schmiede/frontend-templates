                    colPos = 0
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/twoColumns-1-2.xlf:content1
                  }

                  2 {
                    colPos = 1
                    name = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/twoColumns-1-2.xlf:content2
                  }
                }
              }
            }
          }
        }

        icon = EXT:templates/Resources/Public/Icons/BackendLayouts/TwoColumns-1-2.svg
        title = LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TSconfig/Includes/BackendLayouts/twoColumns-1-2.xlf:title
