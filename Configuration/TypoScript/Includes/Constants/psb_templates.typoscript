# customsubcategory=navigation=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.navigation

plugin.tx_psbtemplates {
    resourcePath = EXT:psb_templates/Resources/Public/

    settings {
      navigation {
        # cat=plugin.tx_psbtemplates/navigation; type=int+; label=Parent ID of the footer menu items
        footer =
      }
    }

    view {
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:psb_templates/Resources/Private/Layouts/
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:psb_templates/Resources/Private/Partials/
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:psb_templates/Resources/Private/Templates/
    }
}
