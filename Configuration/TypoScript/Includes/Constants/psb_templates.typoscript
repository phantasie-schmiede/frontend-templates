# customsubcategory=logos=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.logos
# customsubcategory=navigation=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.navigation
# customsubcategory=templates=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.templates

plugin.tx_psbtemplates {
    privateResourcePath = EXT:psb_templates/Resources/Private/
    publicResourcePath = EXT:psb_templates/Resources/Public/

    settings {
      logos {
        # cat=plugin.tx_psbtemplates/logos; type=string; label=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logo.default
        default = EXT:site_package/Resources/Public/Images/logo.svg
      }

      navigation {
        # cat=plugin.tx_psbtemplates/navigation; type=int+; label=LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.navigation.footer
        footer =
      }

      templates {
        # cat=plugin.tx_psbtemplates/templates; type=options[LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.templates.header.centered=Centered, LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.templates.header.leftAligned=LeftAligned]; label= LLL:EXT:psb_templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.templates.header
        header = Centered
      }
    }

    view {
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:psb_templates/Resources/Private/Layouts/
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:psb_templates/Resources/Private/Partials/
        # cat=plugin.tx_psbtemplates/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:psb_templates/Resources/Private/Templates/
    }
}
