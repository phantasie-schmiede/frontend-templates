# customsubcategory=logos=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.logos
# customsubcategory=navigation=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.navigation
# customsubcategory=templates=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:subCategory.templates

plugin.tx_templates {
    privateResourcePath = EXT:templates/Resources/Private/
    publicResourcePath = EXT:templates/Resources/Public/

    settings {
      # cat=plugin.tx_templates/templates; type=string; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.alternativeWebsiteTitle
      alternativeWebsiteTitle =

      logos {
        default {
          # cat=plugin.tx_templates/logos; type=string; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logos.default.file
          file =
          # cat=plugin.tx_templates/logos; type=int+; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logos.default.height
          height =
          # cat=plugin.tx_templates/logos; type=boolean; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logos.default.showWebsiteTitle
          showWebsiteTitle = 0
          # cat=plugin.tx_templates/logos; type=int+; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logos.default.width
          width =
        }

        # cat=plugin.tx_templates/logos; type=string; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.logos.favicon
        favicon =
      }

      navigation {
        # cat=plugin.tx_templates/navigation; type=int+; label=LLL:EXT:templates/Resources/Private/Language/Backend/Configuration/TypoScript/constants.xlf:settings.navigation.footer
        footer =
      }
    }

    view {
        # cat=plugin.tx_templates/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:templates/Resources/Private/Layouts/
        # cat=plugin.tx_templates/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:templates/Resources/Private/Partials/
        # cat=plugin.tx_templates/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:templates/Resources/Private/Templates/
    }
}
