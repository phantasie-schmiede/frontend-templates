plugin.tx_wsscss.variables {
  # cat=plugin.tx_wsscss/color; type=color; label=Danger
  danger = #dc3545

  # cat=plugin.tx_wsscss/color; type=color; label=Dark
  dark = #212529

  # cat=plugin.tx_wsscss/color; type=color; label=Info
  info = #0dcaf0

  # cat=plugin.tx_wsscss/color; type=color; label=Light
  light = #f8f9fa

  # cat=plugin.tx_wsscss/color; type=color; label=Primary
  primary = #0d6efd

  # cat=plugin.tx_wsscss/color; type=color; label=Secondary
  secondary = #6c757d

  # cat=plugin.tx_wsscss/color; type=color; label=Success
  success = #198754

  # cat=plugin.tx_wsscss/color; type=color; label=Warning
