plugin {
  tx_calendarize {
    settings {
      detail.layout.showHero = 1
      paginateConfiguration.maximumNumberOfLinks = 5
    }

    view {
      layoutRootPaths.300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/Calendarize/Layouts/

      partialRootPaths {
        200 = {$plugin.tx_frontendtemplates.view.partialRootPath}
        300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/Calendarize/Partials/
      }

      templateRootPaths.300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/Calendarize/Templates/
    }
  }

  tx_news {
    settings.detail.layout.showHero = 1

    view {
      layoutRootPaths.300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/News/Layouts/

      partialRootPaths {
        200 = {$plugin.tx_frontendtemplates.view.partialRootPath}
        300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/News/Partials/
      }

      templateRootPaths.300 = {$plugin.tx_frontendtemplates.privateResourcePath}Extensions/News/Templates/
    }
  }
}
