page.10.dataProcessing {
  1711319401 = menu
  1711319401 {
    as = mobileMenu
    expandAll = 1
    includeSpacer = 1
    levels = 1
    titleField = nav_title // title
  }
}

[tree.level > 1]
  page.10.dataProcessing {
    1711319409 = menu
    1711319409 {
      as = breadcrumbs
      includeNotInMenu = 0
      special = rootline
      special.range = 0|-1
    }
  }
[end]
