page.10.dataProcessing {
  10 = B13\Menus\DataProcessing\TreeMenu
  10 {
    as = mobileMenu
    depth = 1
    entryPoints = 1
    # excludePages =

    # 0: default, 1 to include nav_hide = 1 pages
    # includeNotInMenu = 0
  }
}

[tree.level > 1]
  page.10.dataProcessing {
    20 = B13\Menus\DataProcessing\BreadcrumbsMenu
    20 {
      as = breadcrumbs
      # excludePages =

      # 0: default, 1 to include nav_hide = 1 pages
      # includeNotInMenu = 0
    }
  }
[end]
