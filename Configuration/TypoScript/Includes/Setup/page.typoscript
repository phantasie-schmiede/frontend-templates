# default page object
page = PAGE
page {
  bodyTag >
  bodyTagCObject = TEXT
  bodyTagCObject.stdWrap.dataWrap = <body class="bl-{field:backend_layout}" id="page-{field:uid}">

  meta {
    viewport = width=device-width, initial-scale=1, shrink-to-fit=no
  }

  includeCSS {
    bootstrap = {$plugin.tx_psbtemplates.resourcePath}Stylesheets/Vendors/bootstrap.min.css
    app = {$plugin.tx_psbtemplates.resourcePath}Stylesheets/App.css
  }

  includeJSFooterlibs {
    bootstrap = {$plugin.tx_psbtemplates.resourcePath}JavaScript/Vendors/bootstrap.bundle.min.js
  }

  includeJSFooter {
    app = {$plugin.tx_psbtemplates.resourcePath}JavaScript/App.js
  }

  10 = FLUIDTEMPLATE
  10 {
    format = html
    templateRootPaths.0 = {$plugin.tx_psbtemplates.view.templateRootPath}Page/
    partialRootPaths.0 = {$plugin.tx_psbtemplates.view.partialRootPath}Page/
    layoutRootPaths.0 = {$plugin.tx_psbtemplates.view.layoutRootPath}Page/

    file.stdWrap.cObject = CASE
    file.stdWrap.cObject {
      key.data = levelfield:-1, backend_layout, slide
      key.override.field = backend_layout

      default = TEXT
      default {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/OneColumn.html
      }

      pagets__PsbBlank = TEXT
      pagets__PsbBlank {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/Blank.html
      }

      pagets__PsbOneColumn = TEXT
      pagets__PsbOneColumn {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/OneColumn.html
      }
    }

    variables {
      mainContent < styles.content.get
    }
  }
}
