# default page object
page = PAGE
page {
#  bodyTagAdd = class="app header-fixed sidebar-fixed aside-menu-fixed aside-menu-hidden"

  meta {
    viewport = width=device-width, initial-scale=1, shrink-to-fit=no
  }

  includeCSS {
    bootstrap = {$plugin.tx_psbtemplates.settings.resourcePath}Stylesheets/Vendors/bootstrap.min.css
    bootstrapIcons = {$plugin.tx_psbtemplates.settings.resourcePath}Icons/Vendors/bootstrap-icons-1.3.0/bootstrap-icons.css
    app = {$plugin.tx_psbtemplates.settings.resourcePath}Stylesheets/App.css
  }

  includeJSFooterlibs {
    10 = {$plugin.tx_psbtemplates.settings.resourcePath}JavaScript/Vendors/jquery-3.3.1.min.js
    20 = {$plugin.tx_psbtemplates.settings.resourcePath}JavaScript/Vendors/bootstrap.bundle.min.js
  }

  includeJSFooter {
    app = {$plugin.tx_psbtemplates.settings.resourcePath}JavaScript/App.js
  }

  10 = FLUIDTEMPLATE
  10 {
    format = html
    templateRootPaths.0 = {$plugin.tx_psbtemplates.view.templateRootPath}Page
    partialRootPaths.0 = {$plugin.tx_psbtemplates.view.partialRootPath}Page
    layoutRootPaths.0 = {$plugin.tx_psbtemplates.view.layoutRootPath}Page

    file.stdWrap.cObject = CASE
    file.stdWrap.cObject {
      key.data = levelfield:-1, backend_layout, slide
      key.override.field = backend_layout

      default = TEXT
      default {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/OneColumn.html
      }

      pagets__PsbBlank = TEXT
      pagets__PsbBlank {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/Blank.html
      }

      pagets__PsbOneColumn = TEXT
      pagets__PsbOneColumn {
        value = {$plugin.tx_psbtemplates.view.templateRootPath}Page/OneColumn.html
      }
    }

    variables {
      mainContent < styles.content.get
    }
  }
}
