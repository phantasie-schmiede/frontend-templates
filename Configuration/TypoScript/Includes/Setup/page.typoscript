# default page object
page = PAGE
page {
  10 = FLUIDTEMPLATE
  10 {
    file.stdWrap.cObject = CASE
    file.stdWrap.cObject {
      key.data = pagelayout

      default = TEXT
      default.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumn.html

      pagets__blank = TEXT
      pagets__blank.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/Blank.html

      pagets__grid-2x2 = TEXT
      pagets__grid-2x2.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/Grid-2x2.html

      pagets__oneColumn = TEXT
      pagets__oneColumn.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumn.html

      pagets__oneColumnThreeColumns-1-1-1 = TEXT
      pagets__oneColumnThreeColumns-1-1-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnThreeColumns-1-1-1.html

      pagets__oneColumnThreeColumns-1-1-1-oneColumn = TEXT
      pagets__oneColumnThreeColumns-1-1-1-oneColumn.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnThreeColumns-1-1-1-OneColumn.html

      pagets__oneColumnThreeColumns-1-2-1-oneColumn = TEXT
      pagets__oneColumnThreeColumns-1-2-1-oneColumn.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnThreeColumns-1-2-1-OneColumn.html

      pagets__oneColumnTwoColumns-1-1 = TEXT
      pagets__oneColumnTwoColumns-1-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnTwoColumns-1-1.html

      pagets__oneColumnTwoColumns-1-2-oneColumn = TEXT
      pagets__oneColumnTwoColumns-1-2-oneColumn.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnTwoColumns-1-2-OneColumn.html

      pagets__oneColumnTwoColumns-2-1-oneColumn = TEXT
      pagets__oneColumnTwoColumns-2-1-oneColumn.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/OneColumnTwoColumns-2-1-OneColumn.html

      pagets__threeColumns-1-1-1 = TEXT
      pagets__threeColumns-1-1-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/ThreeColumns-1-1-1.html

      pagets__threeColumns-1-2-1 = TEXT
      pagets__threeColumns-1-2-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/ThreeColumns-1-2-1.html

      pagets__twoColumns-1-1 = TEXT
      pagets__twoColumns-1-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/TwoColumns-1-1.html

      pagets__twoColumns-1-2 = TEXT
      pagets__twoColumns-1-2.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/TwoColumns-1-2.html

      pagets__twoColumns-1-3 = TEXT
      pagets__twoColumns-1-3.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/TwoColumns-1-3.html

      pagets__twoColumns-2-1 = TEXT
      pagets__twoColumns-2-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/TwoColumns-2-1.html

      pagets__twoColumns-3-1 = TEXT
      pagets__twoColumns-3-1.value = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/TwoColumns-3-1.html
    }

    format = html
    layoutRootPaths.0 = {$plugin.tx_frontendtemplates.view.layoutRootPath}Page/
    partialRootPaths.0 = {$plugin.tx_frontendtemplates.view.partialRootPath}Page/

    settings < plugin.tx_frontendtemplates.settings

    templateRootPaths.0 = {$plugin.tx_frontendtemplates.view.templateRootPath}Page/
  }

  bodyTag >
  bodyTagCObject = TEXT
  bodyTagCObject.stdWrap.dataWrap = <body class="bl-{pagelayout}" id="page-{field:uid}">

  meta {
    viewport = width=device-width, initial-scale=1, shrink-to-fit=no
  }

  includeCSS {
    templates = {$plugin.tx_frontendtemplates.privateResourcePath}Scss/app.scss
    templates.outputfile = {$plugin.tx_frontendtemplates.publicResourcePath}Stylesheets/Vendors/app.min.css
    bootstrap = {$plugin.tx_frontendtemplates.privateResourcePath}Scss/Bootstrap/bootstrap.scss
    bootstrap.outputfile = {$plugin.tx_frontendtemplates.publicResourcePath}Stylesheets/Vendors/bootstrap.min.css
  }

  includeJSFooterlibs {
    bootstrap = {$plugin.tx_frontendtemplates.publicResourcePath}JavaScript/Vendors/bootstrap.bundle.min.js
  }

  shortcutIcon = {$plugin.tx_frontendtemplates.settings.logos.favicon}
}
