# default page object
page {
  10 {
    layoutRootPaths.2 = {$plugin.tx_templates.view.layoutRootPath}Page/
    partialRootPaths.2 = {$plugin.tx_templates.view.partialRootPath}Page/
    settings < plugin.tx_templates.settings
    templateRootPaths.2 = {$plugin.tx_templates.view.templateRootPath}Page/
  }

  includeCSS {
    templates = {$plugin.tx_templates.privateResourcePath}Scss/app.scss
  }
}
