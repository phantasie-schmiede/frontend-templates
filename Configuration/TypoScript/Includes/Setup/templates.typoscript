lib.contentElement {
  partialRootPaths.300 = EXT:templates/Resources/Private/Partials/
  templateRootPaths.300 = EXT:templates/Resources/Private/Templates/ContentElements/Typo3/
}

plugin.tx_templates {
    settings {
        alternativeWebsiteTitle = {$plugin.tx_templates.settings.alternativeWebsiteTitle}

        logos {
            default {
                file = {$plugin.tx_templates.settings.logos.default.file}
                height = {$plugin.tx_templates.settings.logos.default.height}
                showWebsiteTitle = {$plugin.tx_templates.settings.logos.default.showWebsiteTitle}
                width = {$plugin.tx_templates.settings.logos.default.width}
            }

            favicon = {$plugin.tx_templates.settings.logos.favicon}
        }

        navigation {
            footer = {$plugin.tx_templates.settings.navigation.footer}
        }
    }

    view {
        layoutRootPaths.0 = {$plugin.tx_templates.view.layoutRootPath}
        partialRootPaths.0 = {$plugin.tx_templates.view.partialRootPath}
        templateRootPaths.0 = {$plugin.tx_templates.view.templateRootPath}
    }
}
