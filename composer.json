{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\Templates\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "description": "Basic templates for TYPO3",
    "extra": {
        "typo3/cms": {
            "extension-key": "templates"
        }
    },
    "keywords": [
        "extension",
        "templates",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/templates",
    "require": {
        "ext-intl": "*",
        "friendsoftypo3/content-blocks": "~1.5.0",
        "php": "^8.3",
        "psbits/foundation": "@dev",
        "psbits/view-helpers": "@dev",
        "symfony/intl": "^7.1",
        "typo3/cms-core": "^13.4",
        "typo3/cms-fluid-styled-content": "^13",
        "wapplersystems/ws-scss": "^13"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "georgringer/news": "^12",
        "helmich/typo3-typoscript-lint": "^3.3",
        "lochmueller/calendarize": "^14",
        "phpstan/phpstan": "^2.2",
        "psbits/view-helpers": "^3",
        "roave/security-advisories": "dev-latest",
        "saschaegerer/phpstan-typo3": "^2.1"
    },
    "scripts": {
        "analyze:php": "phpstan analyse --configuration=tools/quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit",
        "fix:php": "php-cs-fixer fix --config=tools/quality/.php-cs-fixer.dist.php --verbose",
        "lint:classes": "npm run lint:classes",
        "lint:js": "npm run lint:js",
        "lint:php": "php-cs-fixer fix --config=tools/quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:scss": "npm run lint:scss",
        "lint:typoscript": "typoscript-lint --ansi Configuration/TypoScript",
        "lint:yaml": "yamllint -c tools/quality/.yamllint.yml ContentBlocks Configuration",
        "post-install-cmd": [
            "npm install",
            "cp tools/githooks/pre-commit .git/hooks/pre-commit"
        ],
        "qa": [
            "@validate:composer",
            "@lint:php",
            "@analyze:php",
            "@lint:typoscript",
            "@lint:classes",
            "@lint:js",
            "@lint:scss"
        ],
        "validate:composer": "composer validate --no-check-publish"
    },
    "type": "typo3-cms-extension"
}
