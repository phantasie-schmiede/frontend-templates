		"psbits/foundation": "@dev",
		"psbits/view-helpers": "@dev",
		"symfony/intl": "^7.1",
        "typo3/cms-core": "^13.4",
        "typo3/cms-fluid-styled-content": "^13",
        "wapplersystems/ws-scss": "^13"
