{
  "name": "templates",
  "version": "1.0.0",
  "description": "Basic templates for TYPO3",
  "scripts": {
    "fix:classes": "node Build/Quality/lint-class-attributes.mjs",
    "lint:js": "eslint \"Resources/Public/JavaScript/**/*.js\" --config Build/Quality/eslint.config.cjs --ignore-pattern \"Resources/Public/JavaScript/Vendors/**\"",
    "lint:classes": "node Build/Quality/lint-class-attributes.mjs --dry-run",
    "lint:scss": "stylelint \"Resources/Private/Scss/**/*.{scss,sass}\" --config Build/Quality/.stylelintrc.json --ignore-path Build/Quality/.stylelintignore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasie-schmiede/templates.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/phantasie-schmiede/templates/issues"
  },
  "homepage": "https://github.com/phantasie-schmiede/templates#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
