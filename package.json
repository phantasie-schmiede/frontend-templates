{
  "name": "templates",
  "version": "1.0.0",
  "description": "Basic templates for TYPO3",
  "scripts": {
    "fix:classes": "node tools/quality/lint-class-attributes.mjs --fix",
    "fix:htmlxml": "find Resources/Public -type f -name '*.html' -print0 | xargs -0 -r prettier --write && find . -type f \\( -name '*.xml' -o -name '*.xlf' \\) -print0 | xargs -0 -r prettier --write --plugin=@prettier/plugin-xml",
    "lint:html": "htmlhint \"Resources/Public/**/*.html\" --config tools/quality/.htmlhintrc",
    "lint:htmlxml": "npm run lint:html && npm run lint:xml",
    "lint:js": "eslint \"Resources/Public/JavaScript/**/*.js\" --ignore-pattern \"Resources/Public/JavaScript/Vendors/**\"",
    "lint:xml": "find . -type f \\( -name '*.xml' -o -name '*.xlf' \\) -print0 | xargs -0 -r prettier --check --plugin=@prettier/plugin-xml",
    "lint:classes": "node tools/quality/lint-class-attributes.mjs",
    "lint:scss": "stylelint \"Resources/Private/Scss/**/*.{scss,sass}\" --ignore-path tools/quality/.stylelintignore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasie-schmiede/templates.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/phantasie-schmiede/templates/issues"
  },
  "homepage": "https://github.com/phantasie-schmiede/templates#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "eslint": "^10.4.1",
    "htmlhint": "1.1.4",
    "prettier": "^3.6.2",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
