{
  "name": "frontend-templates",
  "version": "1.0.0",
  "description": "Frontend templates for TYPO3: page layouts, content elements, ViewHelpers and TypoScript setup, built on Bootstrap and Content Blocks",
  "scripts": {
    "fix:classes": "node .Build/vendor/psbits/qa/Resources/Quality/lint-class-attributes.mjs",
    "fix:htmlxml": "prettier --config .Build/vendor/psbits/qa/Resources/Quality/prettier.config.mjs --ignore-path Build/Quality/.prettierignore --write \"**/*.{html,xml,xlf}\"",
    "lint:classes": "node .Build/vendor/psbits/qa/Resources/Quality/lint-class-attributes.mjs --dry-run",
    "lint:htmlxml": "prettier --config .Build/vendor/psbits/qa/Resources/Quality/prettier.config.mjs --ignore-path Build/Quality/.prettierignore --check \"**/*.{html,xml,xlf}\"",
    "lint:js": "eslint \"Resources/Public/JavaScript/**/*.js\" --config Build/Quality/eslint.config.cjs --ignore-pattern \"Resources/Public/JavaScript/Vendors/**\"",
    "lint:scss": "stylelint \"Resources/Private/Scss/**/*.{scss,sass}\" --config Build/Quality/.stylelintrc.json --ignore-path Build/Quality/.stylelintignore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasie-schmiede/frontend-templates.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/phantasie-schmiede/frontend-templates/issues"
  },
  "homepage": "https://github.com/phantasie-schmiede/frontend-templates#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
